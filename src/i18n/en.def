// English.  The ids are in i18n/ids.def.
//
//   S(id, text)
//   P(id, 1, other)
//
// "Other" includes 0: 0 lines.  {0} in a P line is the number; {0}, {1}...
// elsewhere are filled by i18n::Format.
//
// Written for the ear first: no abbreviation the synthesizer reads letter by
// letter, no symbol it skips.

P(kLines, L"{0} line", L"{0} lines")

// model/transcript
S(kQuestionsMore, L"{0} (+{1} more)")
S(kQuestionMultiSelect, L"{0} (choose any number)")
S(kFileLine, L"file: {0}")
S(kReplaceBefore, L"before:")
S(kReplaceAfter, L"after:")
S(kReplaceEverywhere, L"every occurrence")
S(kNewContent, L"content:")
S(kDiff, L"change:")
S(kLinesToLines, L"{0} to {1}")
S(kThinkingSummary, L"thinking ({0})")
S(kWritten, L"written")
S(kCreated, L"created")
S(kOutput, L"output")
S(kError, L"error")
S(kOutputEmpty, L"output (empty)")
S(kErrorEmpty, L"error (empty)")
S(kExpanded, L"{0}, expanded")
S(kInterrupted, L"Interrupted by the user.")
S(kToolDenied, L"Tool {0} was denied.")
S(kSpeakerUser, L"you: ")
// proto/
S(kImage, L"[image]")
S(kToolDeclined, L"denied")
S(kReasonRule, L"a rule in the settings, or a hook (rule)")
S(kReasonSubcommands, L"evaluation of subcommands (subcommandResults)")
S(kModeNormal, L"normal")
S(kModePlan, L"planning")
S(kModePlanGloss, L"only researches and proposes, never touches files")
S(kClaudeModeNormalGloss, L"asks before every edit and every command")
S(kClaudeModeAcceptEdits, L"accept edits")
S(kClaudeModeAcceptEditsGloss, L"changes files on its own, asks before commands")
S(kClaudeModeAuto, L"auto")
S(kClaudeModeAutoGloss, L"Claude decides what is safe")
S(kClaudeModeBypass, L"no permissions")
S(kClaudeModeBypassGloss, L"never asks")
S(kClaudeModeDontAsk, L"don't ask")
S(kClaudeModeDontAskGloss, L"denies anything risky outright")
S(kCodexModeNormalGloss, L"changes files in the project, asks before commands outside it")
S(kCodexModeReadOnly, L"read only")
S(kCodexModeReadOnlyGloss, L"may only read; has to ask for anything it wants to change")
S(kCodexModeFullAccess, L"full access")
S(kCodexModeFullAccessGloss, L"never asks and reaches anywhere")
S(kCodexModeCustom, L"custom")
S(kCodexModeCustomGloss, L"settings from Codex's configuration")

S(kKindPrompt, L"prompt")
S(kKindAnswer, L"answer")
S(kKindDenied, L"denied")
S(kKindInterrupted, L"interruption")
S(kKindThinking, L"thinking")
S(kKindTool, L"tool")
S(kKindOutput, L"output")
