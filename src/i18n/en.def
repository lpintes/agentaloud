// ui/keys_dialog
S(kKeysSending,
  L"Sending and the turn:\n"
  L"Ctrl+Enter — sends the prompt. Only from the Prompt field.\n"
  L"Esc — interrupts the running turn. From either field.\n"
  L"Tab — switches between the transcript and the prompt.\n")
S(kKeysModesNone, L"Shift+Tab — this agent cannot change modes while running.\n")
S(kKeysModesHeading,
  L"Shift+Tab — cycles the permission mode, from either field:\n")
S(kKeysModesStartOnly, L"Only at startup, with --permission-mode: {0}.\n")
S(kKeysMoving,
  L"\n"
  L"Moving through the transcript:\n"
  L"T — next tool call, Shift+T — previous.\n"
  L"R — next tool output, Shift+R — previous.\n"
  L"P — next prompt, Shift+P — previous.\n"
  L"A — next answer, Shift+A — previous.\n"
  L"K — next thinking, Shift+K — previous.\n"
  L"E — next error or denied call, Shift+E — previous.\n"
  L"Shift means backwards. These six letters work only in the transcript.\n"
  L"Ctrl+Shift+T, R, P, A, K, E — the same forwards, from the Prompt field too.\n"
  L"Enter — collapses or expands the block under the cursor. Only in the transcript.\n"
  L"Ctrl+C — copies the selected text. The transcript field does that itself.\n"
  L"\n"
  L"Bookmarks, from either field:\n"
  L"Ctrl+Shift+1 to Ctrl+Shift+9 — marks the block the cursor is on.\n"
  L"Ctrl+1 to Ctrl+9 — returns the cursor to the marked block.\n"
  L"Ctrl+0 — back to where the cursor was when something last arrived.\n"
  L"Bookmark zero is written by the application, it cannot be set.\n"
  L"\n"
  L"Searching, from either field:\n"
  L"Ctrl+F — finds text in the transcript. Case does not matter.\n"
  L"The dialog stays open: Enter finds the next match, Esc closes it.\n"
  L"F3 — next match, Shift+F3 — previous.\n"
  L"Collapsed blocks are searched too; the block with the match is expanded.\n"
  L"\n"
  L"Dialogs and the clipboard, from either field:\n"
  L"F1 — this list.\n"
  L"F2 — session details: id, model, context, cost.\n")
S(kKeysCommands,
  L"F4 — list of slash commands. The chosen one goes into the prompt, unsent.\n")
S(kKeysNoCommands, L"F4 — list of slash commands; this agent has none.\n")
S(kKeysCopyId, L"Ctrl+Shift+C — copies the session id to the clipboard.")
S(kKeysSessions,
  L"\n\n"
  L"More sessions:\n"
  L"Ctrl+N — new session, in another window.\n"
  L"Ctrl+Tab or Ctrl+F6 — next session, "
  L"Ctrl+Shift+Tab or Ctrl+Shift+F6 — previous.\n"
  L"Ctrl+F4 — closes the session. Alt+F4 — quits the application.\n"
  L"Alt — the menu; Window in it lists the open sessions.")

S(kMenuFile, L"&File")
