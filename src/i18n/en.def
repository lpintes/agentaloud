S(kMenuPreviousSession, L"&Previous session\tCtrl+Shift+Tab")
S(kMenuCloseSession, L"&Close session\tCtrl+F4")
S(kSayNoSession, L"no session is open")
S(kSayOnlySession, L"this is the only open session")

