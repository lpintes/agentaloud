S(kHelpTitle, L"nápoveda")
S(kSeeHelp, L"Zoznam volieb vypíše {0} --help.")
S(kSettingsLine, L"riadok {0}: {1}")
S(kSettingsNotKeyValue, L"očakáva sa kľúč=hodnota, je tam „{0}“")
S(kSettingsDuplicate, L"kľúč {0} je už na riadku {1}")
S(kSettingsCheckUpdates, L"check-updates je 0 alebo 1, nie {0}")
S(kUnknownLanguage, L"neznámy jazyk {0}; známe sú: {1}")
S(kUnknownKey, L"neznámy kľúč {0}")
S(kSettingsFileError, L"nastavenia {0}, {1}")
S(kNoRichEdit, L"Nepodarilo sa načítať Msftedit.dll.")
S(kSessionStartFailed, L"Nepodarilo sa spustiť session.")
S(kProgramNotFound,
  L"Program {0} sa nenašiel. Je nainštalovaný a je na ceste PATH?")
S(kProgramNotStarted, L"Program {0} sa nepodarilo spustiť (chyba {1}). {2}")
S(kPackageBadPath, L"balík obsahuje neplatnú cestu {0}")
S(kPackageMissing, L"v balíku chýba {0}")

