// Slovenčina.  The ids are in i18n/ids.def.
//
//   S(id, text)
//   P(id, 1, 2-4, other)
//
// "Other" is everything else, 0 included: 0 riadkov, 5 riadkov, 22 riadkov.
// Slovak looks at the whole number, not at its last digit.  {0} in a P line
// is the number; {0}, {1}... elsewhere are filled by i18n::Format.
//
// Written for the ear first: no abbreviation the synthesizer reads letter by
// letter, no symbol it skips.

P(kLines, L"{0} riadok", L"{0} riadky", L"{0} riadkov")

// model/transcript
S(kQuestionsMore, L"{0} (+{1} ďalšie)")
S(kQuestionMultiSelect, L"{0} (dá sa označiť viac)")
S(kFileLine, L"súbor: {0}")
S(kReplaceBefore, L"pôvodné:")
S(kReplaceAfter, L"nové:")
S(kReplaceEverywhere, L"všetky výskyty")
S(kNewContent, L"obsah:")
S(kDiff, L"zmena:")
S(kLinesToLines, L"{0} na {1}")
S(kThinkingSummary, L"premýšľanie ({0})")
S(kWritten, L"zapísané")
S(kCreated, L"vytvorené")
S(kOutput, L"výstup")
S(kError, L"chyba")
S(kOutputEmpty, L"výstup (prázdny)")
S(kErrorEmpty, L"chyba (prázdna)")
S(kExpanded, L"{0}, rozbalené")
S(kInterrupted, L"Prerušené používateľom.")
S(kToolDenied, L"Nástroj {0} bol zamietnutý.")
// "ja", not "ty": the transcript is the reader's own record of a
// conversation they took part in, and the app says "Máte" elsewhere, so a
// "ty" would also be the one place it is on first-name terms.
S(kSpeakerUser, L"ja: ")
// proto/
S(kImage, L"[obrázok]")
S(kToolDeclined, L"zamietnuté")
S(kReasonRule, L"pravidlo v nastaveniach alebo hook (rule)")
S(kReasonSubcommands, L"vyhodnotenie podpríkazov (subcommandResults)")
S(kModeNormal, L"normálny")
S(kModePlan, L"plánovanie")
S(kModePlanGloss, L"len skúma a navrhuje, súborov sa nedotkne")
S(kClaudeModeNormalGloss, L"pýta sa na každú úpravu aj na príkazy")
S(kClaudeModeAcceptEdits, L"automatické úpravy")
S(kClaudeModeAcceptEditsGloss, L"súbory mení sám, na príkazy sa pýta")
S(kClaudeModeAuto, L"auto")
S(kClaudeModeAutoGloss, L"Claude sám rozhodne, čo je bezpečné")
S(kClaudeModeBypass, L"bez povolení")
S(kClaudeModeBypassGloss, L"nepýta sa na nič")
S(kClaudeModeDontAsk, L"bez pýtania")
S(kClaudeModeDontAskGloss, L"riskantné rovno zamietne")
S(kCodexModeNormalGloss, L"mení súbory v projekte, na príkazy mimo neho sa pýta")
S(kCodexModeReadOnly, L"len čítanie")
S(kCodexModeReadOnlyGloss, L"smie len čítať, čo chce zmeniť, musí si vypýtať")
S(kCodexModeFullAccess, L"plný prístup")
S(kCodexModeFullAccessGloss, L"nepýta sa na nič a siaha kamkoľvek")
S(kCodexModeCustom, L"vlastný")
S(kCodexModeCustomGloss, L"nastavenie z konfigurácie Codexu")

S(kKindPrompt, L"prompt")
S(kKindAnswer, L"odpoveď")
S(kKindDenied, L"zamietnuté")
S(kKindInterrupted, L"prerušenie")
S(kKindThinking, L"premýšľanie")
S(kKindTool, L"nástroj")
S(kKindOutput, L"výstup")
