// Dialog templates.  Layout is in dialog units and computed by nobody, which
// is what makes the whole thing scale with the dialog font -- see win/dialog.h
// for why these are real dialogs and not windows that look like ones.
//
// The values are read-only EDIT controls rather than static text on purpose.
// A static cannot take focus, so a screen reader cannot walk it character by
// character and nothing in it can be selected; a session id is 36 characters
// of hex whose whole use is being copied out, so both of those matter.

#include <windows.h>

#include "ui/resource.h"

// This file is UTF-8 and windres would otherwise read it as codepage 1252,
// which turns every accented letter in a caption into two.  It compiles either
// way, so it is found by reading the dialog, not by building it.  The Makefile
// says the same thing again with --codepage=65001; either alone is enough.
#pragma code_page(65001)

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_SESSION_DETAILS DIALOGEX 0, 0, 320, 182
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClaudeLens — podrobnosti session"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "&Id session:", IDC_DETAILS_ID_LABEL, 8, 10, 74, 8
    EDITTEXT        IDC_DETAILS_ID, 86, 8, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Model:", IDC_DETAILS_MODEL_LABEL, 8, 28, 74, 8
    EDITTEXT        IDC_DETAILS_MODEL, 86, 26, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Režim povolení:", IDC_DETAILS_MODE_LABEL, 8, 46, 74, 8
    EDITTEXT        IDC_DETAILS_MODE, 86, 44, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Priečinok:", IDC_DETAILS_PROJECT_LABEL, 8, 64, 74, 8
    EDITTEXT        IDC_DETAILS_PROJECT, 86, 62, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Kontext:", IDC_DETAILS_CONTEXT_LABEL, 8, 82, 74, 8
    EDITTEXT        IDC_DETAILS_CONTEXT, 86, 80, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Úč&et:", IDC_DETAILS_ACCOUNT_LABEL, 8, 100, 74, 8
    EDITTEXT        IDC_DETAILS_ACCOUNT, 86, 98, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Cena:", IDC_DETAILS_COST_LABEL, 8, 118, 74, 8
    EDITTEXT        IDC_DETAILS_COST, 86, 116, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Tokeny:", IDC_DETAILS_TOKENS_LABEL, 8, 136, 74, 8
    EDITTEXT        IDC_DETAILS_TOKENS, 86, 134, 226, 12, ES_AUTOHSCROLL | ES_READONLY

    DEFPUSHBUTTON   "&Skopírovať id", IDC_DETAILS_COPY, 190, 160, 66, 14
    PUSHBUTTON      "&Zavrieť", IDCANCEL, 262, 160, 50, 14
END

// The question with options.  One question per dialog, shown in turn, which is
// what lets a fixed template cover the whole tool: the count of questions and
// of options varies, the shape of one question does not.
//
// Two list boxes in the same place and only one of them ever shown.  A list
// box cannot be told after creation whether it takes one selection or several,
// and the answer to that is in the request; a checkbox for each option would
// need the count baked into the template instead.  The one not in use is
// hidden AND disabled, so the tab order skips it -- see ui/ask_dialog.cpp.
//
// The option's description is part of its line rather than a box of its own.
// Read aloud, one line per option is one thing to listen to; a description
// beside the list is a second place to go and look for every option tried.
IDD_ASK_QUESTION DIALOGEX 0, 0, 300, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClaudeLens — otázka"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "O&tázka:", IDC_ASK_QUESTION_LABEL, 8, 8, 284, 8
    EDITTEXT        IDC_ASK_QUESTION, 8, 18, 284, 32,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    LTEXT           "&Možnosti:", IDC_ASK_OPTIONS_LABEL, 8, 56, 284, 8
    LISTBOX         IDC_ASK_OPTIONS, 8, 66, 284, 76,
                    LBS_NOTIFY | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL |
                    WS_HSCROLL | WS_TABSTOP
    LISTBOX         IDC_ASK_OPTIONS_MULTI, 8, 66, 284, 76,
                    LBS_NOTIFY | LBS_HASSTRINGS | LBS_MULTIPLESEL | WS_BORDER |
                    WS_VSCROLL | WS_HSCROLL | WS_TABSTOP

    LTEXT           "&Vlastná odpoveď:", IDC_ASK_OTHER_LABEL, 8, 148, 284, 8
    EDITTEXT        IDC_ASK_OTHER, 8, 158, 284, 12, ES_AUTOHSCROLL

    DEFPUSHBUTTON   "&Odpovedať", IDOK, 172, 176, 56, 14
    PUSHBUTTON      "&Zamietnuť", IDCANCEL, 236, 176, 56, 14
END

// The permission prompt.  What it replaced was a MessageBox with the tool's
// arguments in it as input.dump(2) -- one line of JSON with the line breaks
// spelled "\n", which is read out as "backslash en" and cannot be walked by
// line or by word at all.  A commit message went past that box unread.
//
// Three read-only fields and no field for the tool's name: the name is in the
// caption, which is what NVDA reads first when the dialog opens, and the focus
// is put in the arguments.  So opening it says the tool and then the command,
// in that order, without a Tab.
//
// The default button is Zamietnuť, so Enter and Esc agree.  Allowing is the
// answer that has to be aimed at.
IDD_PERMISSION DIALOGEX 0, 0, 320, 212
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClaudeLens — povolenie"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "P&opis:", IDC_PERM_DESCRIPTION_LABEL, 8, 10, 60, 8
    EDITTEXT        IDC_PERM_DESCRIPTION, 72, 8, 240, 12,
                    ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Dôvod:", IDC_PERM_REASON_LABEL, 8, 28, 60, 8
    EDITTEXT        IDC_PERM_REASON, 72, 26, 240, 12,
                    ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "&Argumenty:", IDC_PERM_INPUT_LABEL, 8, 46, 304, 8
    EDITTEXT        IDC_PERM_INPUT, 8, 56, 304, 128,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    PUSHBUTTON      "&Povoliť", IDOK, 196, 190, 56, 14
    DEFPUSHBUTTON   "&Zamietnuť", IDCANCEL, 256, 190, 56, 14
END

// The slash command picker.  A filter box above a list, because the list is
// seventy-nine entries long on this account and walking it with the arrow keys
// means listening to seventy-nine descriptions.
//
// The description is in a box of its own here, unlike in the question dialog
// where it is folded into the option's line.  The reason is length: an option
// in a question is a phrase, while a command's description runs to over a
// thousand characters, and a list line that long is unusable both to read and
// to hear.  The line therefore carries the name, the argument hint and as much
// of the description as fits on one line, and the box has the whole of it for
// the one command being considered.
IDD_COMMANDS DIALOGEX 0, 0, 320, 204
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClaudeLens — príkazy"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "&Filter:", IDC_CMD_FILTER_LABEL, 8, 10, 40, 8
    EDITTEXT        IDC_CMD_FILTER, 52, 8, 260, 12, ES_AUTOHSCROLL

    LTEXT           "&Príkazy:", IDC_CMD_LIST_LABEL, 8, 26, 304, 8
    LISTBOX         IDC_CMD_LIST, 8, 36, 304, 92,
                    LBS_NOTIFY | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL |
                    WS_HSCROLL | WS_TABSTOP

    LTEXT           "P&opis:", IDC_CMD_DETAIL_LABEL, 8, 132, 304, 8
    EDITTEXT        IDC_CMD_DETAIL, 8, 142, 304, 38,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    DEFPUSHBUTTON   "&Vložiť", IDOK, 196, 184, 56, 14
    PUSHBUTTON      "&Zrušiť", IDCANCEL, 256, 184, 56, 14
END
