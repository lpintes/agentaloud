<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Common Controls 6, for TaskDialogIndirect (the update dialogs).  Without
     it the process binds to comctl32 5, which has no TaskDialogIndirect, and
     the loader refuses to start the EXE at all - silently, from Explorer.
     DPI awareness is NOT declared here: wWinMain sets it in code, and the
     reason it must be set at all is in CLAUDE.md, invariant 9. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="AgentAloud" version="1.0.0.0"
                    processorArchitecture="*"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
