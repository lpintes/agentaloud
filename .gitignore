
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# Zamky bd >= 1.3.0 ("cooperative gate") vedla .beads aj vnutri neho.  Su to
# len mena pre flock, bd ich zamerne nemaze a pri dalsom prikaze vytvori znova.
*.gate.lock*

# Surovy zaznam spiku -- obsahuje session id a ceny, nie je to zdroj pravdy.
tools/spike_control.log

# To iste pre sondu na slash prikazy: pise cele zaznamy do cwd, lebo konzola
# je cp1250 a print by na sipke v popise spadol.
probe_slash.out

# Vysledky zostavenia.
build/
bin/

# Generuje `make compdb` z Makefile; stroj od stroja iny (absolutne cesty).
compile_commands.json

# Docasna poznamka pre dalsiu session, nie zdroj pravdy -- ta je v beads.
next-task.md

# Vznikne, ked sa tools/ importuje ako modul (rucne skusanie Scrubbera).
tools/__pycache__/
SESSION.md
